# Multiplayer Tailscale host config. Copy to `.env` (gitignored) and fill in.
# Use this machine's Tailscale IPv4 (`tailscale ip -4`) or MagicDNS name.
KILLBOX_PUBLIC_URL=http://YOUR-TAILSCALE-IP:2567
KILLBOX_CLIENT_PUBLIC_URL=http://YOUR-TAILSCALE-IP:5173
# A private value shared with the other player out-of-band. Do not commit.
KILLBOX_ROOM_SECRET=replace-with-a-private-value
